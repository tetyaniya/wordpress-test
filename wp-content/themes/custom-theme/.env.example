# WordPress origin allowed to request Vite resources (no trailing slash).
WP_ORIGIN=https://wordpress-test.ddev.site
# Browser-facing Vite URL; run npm on the host/WSL, outside DDEV.
VITE_DEV_ORIGIN=https://localhost:5173
# Optional trusted certificate files. Otherwise a self-signed certificate is used.
# VITE_HTTPS_KEY=/absolute/path/to/localhost-key.pem
# VITE_HTTPS_CERT=/absolute/path/to/localhost.pem
